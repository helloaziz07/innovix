# ============================================
# Innovix Backend — Environment Variables
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Google Gemini ---
GEMINI_API_KEY=your-gemini-api-key-here

# --- GitHub ---
GITHUB_TOKEN=your-github-personal-access-token

# --- Search APIs (both recommended — they complement each other) ---
SERPAPI_KEY=your-serpapi-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# --- Semantic Scholar (optional, works without key at lower rate) ---
SEMANTIC_SCHOLAR_API_KEY=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- Sarvam AI (Multilingual TTS/STT — required for Phase 7) ---
SARVAM_API_KEY=your-sarvam-api-key-here

# --- Email Services (Choose one or configure both) ---
# Resend API (Recommended)
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=Innovix <no-reply@innovixapp.site>

# Custom SMTP (e.g., Gmail, Resend SMTP, SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_EMAIL=resend
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=Innovix <no-reply@innovixapp.site>

# --- App Config ---
APP_NAME=Innovix
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
